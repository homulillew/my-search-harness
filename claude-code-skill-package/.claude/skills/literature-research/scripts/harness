#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
skill_dir="${CLAUDE_SKILL_DIR:-$(cd -- "$script_dir/.." && pwd)}"

if [[ -x "$skill_dir/.venv/bin/python" ]]; then
  python_bin="$skill_dir/.venv/bin/python"
else
  python_bin="${PYTHON:-python3}"
fi

if [[ -d "$skill_dir/runtime/src/my_search_harness" ]]; then
  export PYTHONPATH="$skill_dir/runtime/src${PYTHONPATH:+:$PYTHONPATH}"
else
  project_root="$(cd -- "$skill_dir/../../.." && pwd)"
  if [[ -d "$project_root/src/my_search_harness" ]]; then
    export PYTHONPATH="$project_root/src${PYTHONPATH:+:$PYTHONPATH}"
  fi
fi

exec "$python_bin" "$script_dir/harness.py" "$@"
